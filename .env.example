# Required: Bearer token for MetaMCP HTTP transport and UI authentication
# Generate a secure random token: openssl rand -hex 32
METAMCP_HTTP_BEARER_TOKEN=your-secure-bearer-token-here

# Optional: Comma-separated list of allowed CORS origins
# Example: https://example.com,https://app.example.com
# Leave empty or unset for no CORS restrictions
METAMCP_ALLOWED_ORIGINS=

# Optional: Host ports (container listen ports stay 8080 / 3000)
# Set these in the Portainer stack env when 8080 or 3000 already clash
METAMCP_PORT=8080
UI_PORT=3000
